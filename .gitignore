# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Private recipe exports, transformed catalogs and import media (never source)
*.zip
/private-imports/
/import-data/
/recipe-exports/
/recipes.html
/recipes.json
/images/
Copy_Me_That*
*.private.json

# Personal vault exports, local experiments, keys, and private documents
/vault-data/
/vault-exports/
/private-documents/
*.vault-backup
*.key
*.p12
*.pfx
